# protobuf: Protocol Buffers in Zig: a field-by-field reader and writer for the wire format, with no .proto files, no generated code, and caller-owned buffers. `just --list` shows the recipes.
# AGENTS.md holds the working conventions.

[private]
default:
    @just --list

[doc("Build the site into zig-out/site/protobuf/: the guide (Zola, from docs/) and the API reference (docgen JSON, rendered by the theme's api.html) under api/. The router in baskingspot/site serves /protobuf/... from it")]
[group("docs")]
doc: api
    baskingspot-docs build protobuf

[doc("Edit the guide with live reload (http://127.0.0.1:1111), API reference included")]
[group("docs")]
guide: api
    baskingspot-docs serve protobuf

# The API reference data. docgen comes from the baskingspot flake's docs shell,
# so this is not a Zig build dependency.
[private]
api:
    docgen --root src/root.zig --title protobuf --repo-url https://github.com/baskingspot/protobuf --rev main --format json --out docs/data

[doc("Deploy the rendered docs to Cloudflare as an assets-only Worker (config in wrangler.jsonc). Needs CLOUDFLARE_API_TOKEN in the environment, plus CLOUDFLARE_ACCOUNT_ID if the token can see more than one account")]
[group("docs")]
doc-deploy: doc
    wrangler deploy

[doc("Unit tests, the protoc interop tests, and the docs examples")]
[group("test")]
test:
    zig build test --summary all

[doc("Run the benchmarks (ReleaseFast). Extra args go to the benchmark binary")]
[group("bench")]
bench *ARGS:
    zig build bench -- {{ ARGS }}

[doc("Regenerate test/data/fixtures.txtar from the .proto and .txt sources")]
[group("test")]
proto:
    #!/usr/bin/env bash
    set -euo pipefail
    cd test/data
    {
        echo "Generated by 'just proto'. Each section is the protoc --encode output"
        echo "for a text-format message, hex encoded so it diffs and reads."
        for txt in */*.txt; do
            proto=$(sed -n '1s/^# proto: //p' "$txt")
            type=$(sed -n '2s/^# type: //p' "$txt")
            if [ -z "$proto" ] || [ -z "$type" ]; then
                echo "$txt: needs '# proto: <file>' and '# type: <message>' first" >&2
                exit 1
            fi
            echo "-- ${txt%.txt}.pb --"
            protoc -I . --encode="$type" "$proto" < "$txt" \
                | od -An -v -tx1 | tr -d ' \n' | fold -w 64
            # fold does not end the stream with a newline, and the next marker
            # has to start a line.
            echo
        done
    } > fixtures.txtar
    echo "wrote test/data/fixtures.txtar"

[doc("Lint Zig, Nix, Markdown, the workflows, and this justfile: ziglint, zig fmt, nix fmt, oxfmt, actionlint, zizmor, and just --fmt")]
[group("lint")]
lint:
    ziglint
    zig fmt --check src test docs/examples bench build.zig build.zig.zon
    nix fmt -- --ci
    oxfmt --check README.md AGENTS.md docs/content docs/config.toml .github
    actionlint
    zizmor .
    just --fmt --check

[doc("Format everything lint checks")]
[group("lint")]
fmt:
    zig fmt src test docs/examples bench build.zig build.zig.zon
    nix fmt
    oxfmt README.md AGENTS.md docs/content docs/config.toml .github
    just --fmt

[doc("Everything CI runs")]
[group("ci")]
ci: test lint
