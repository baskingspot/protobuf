# protobuf: Protocol Buffers in Zig: a field-by-field reader and writer for the wire format, with no .proto files, no generated code, and caller-owned buffers. `just --list` shows the recipes.
# AGENTS.md holds the working conventions.

[private]
default:
    @just --list

[doc("Unit tests")]
[group("test")]
test:
    zig build test --summary all

[doc("Run the benchmarks (ReleaseFast). Extra args go to the benchmark binary")]
[group("bench")]
bench *ARGS:
    zig build bench -- {{ ARGS }}

[doc("Regenerate test/data/fixtures.txtar from the .proto and .txt sources")]
[group("test")]
proto:
    #!/usr/bin/env bash
    set -euo pipefail
    cd test/data
    {
        echo "Generated by 'just proto'. Each section is the protoc --encode output"
        echo "for a text-format message, hex encoded so it diffs and reads."
        for txt in */*.txt; do
            proto=$(sed -n '1s/^# proto: //p' "$txt")
            type=$(sed -n '2s/^# type: //p' "$txt")
            if [ -z "$proto" ] || [ -z "$type" ]; then
                echo "$txt: needs '# proto: <file>' and '# type: <message>' first" >&2
                exit 1
            fi
            echo "-- ${txt%.txt}.pb --"
            protoc -I . --encode="$type" "$proto" < "$txt" \
                | od -An -v -tx1 | tr -d ' \n' | fold -w 64
            # fold does not end the stream with a newline, and the next marker
            # has to start a line.
            echo
        done
    } > fixtures.txtar
    echo "wrote test/data/fixtures.txtar"

[doc("Lint Zig, Nix, Markdown, the workflows, and this justfile: ziglint, zig fmt, nix fmt, oxfmt, actionlint, zizmor, and just --fmt")]
[group("lint")]
lint:
    ziglint
    zig fmt --check src test bench build.zig build.zig.zon
    nix fmt -- --ci
    oxfmt --check README.md AGENTS.md .github
    actionlint
    zizmor .
    just --fmt --check

[doc("Format everything lint checks")]
[group("lint")]
fmt:
    zig fmt src test bench build.zig build.zig.zon
    nix fmt
    oxfmt README.md AGENTS.md .github
    just --fmt

[doc("Everything CI runs")]
[group("ci")]
ci: test lint
